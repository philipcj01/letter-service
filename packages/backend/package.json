{
  "name": "@cloudletters/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit --incremental",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy": "dotenv -e .env -- cdk deploy",
    "destroy": "dotenv -e .env -- cdk destroy",
    "synth": "cdk synth --all -o cdk.out",
    "lint": "eslint src test --no-error-on-unmatched-pattern",
    "unittest": "jest --testPathPattern test/unittest",
    "integrationtest": "jest --testPathPattern test/integrationtest"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@jest/globals": "^29.7.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.15",
    "aws-cdk": "^2.170.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "dotenv-cli": "^8.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.11.0",
    "@aws-lambda-powertools/metrics": "^2.33.1",
    "@aws-lambda-powertools/parameters": "^2.11.0",
    "@aws-lambda-powertools/tracer": "^2.11.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-ses": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.1055.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1055.0",
    "@react-pdf/renderer": "^4.1.5",
    "@cloudletters/shared": "workspace:*",
    "axios": "^1.16.1",
    "lru-cache": "^11.5.1",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  }
}
